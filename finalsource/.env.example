# Public port used to open the application in a browser.
APP_PORT=18080
# Loopback-only backend port for researcher API/Swagger inspection.
BACKEND_PORT=13000

# MySQL application user/database. Change MYSQL_PASSWORD before starting.
MYSQL_DATABASE=research_100ms
MYSQL_USER=research_100ms
MYSQL_PASSWORD=change-this-local-database-password

# Use at least 32 random characters. Never commit finalsource/.env.
JWT_SECRET=change-this-to-at-least-32-random-characters
