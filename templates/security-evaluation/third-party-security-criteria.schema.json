{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "third-party-security-criteria.schema.json",
  "title": "Canonical SR-blind third-party security criteria catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "catalog_id", "status", "scope", "sources", "criteria"],
  "properties": {
    "artifact_type": {"const": "third-party-security-criteria-catalog"},
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "pattern": "^TSC-[A-Z0-9-]+$"},
    "status": {"enum": ["Draft", "Approved"]},
    "researcher": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"]},
    "scope": {"const": ["A01", "A02"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publisher", "title", "url", "source_type", "version_or_revision", "retrieved_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "source_type": {"enum": ["security-standard", "vendor-rule-catalog", "vendor-documentation", "weakness-taxonomy"]},
          "version_or_revision": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterion"}
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "tool", "detector_type", "rule_id", "rule_origin", "maturity", "severity", "classification", "detection_intent", "applicability", "evidence_fields", "limitations", "source_ids", "rule_reference"],
      "properties": {
        "id": {"type": "string", "pattern": "^TSC-A0[12]-(SEMGREP|ZAP)-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "category": {"enum": ["A01", "A02"]},
        "tool": {"enum": ["semgrep", "zap"]},
        "detector_type": {"enum": ["static-search", "static-taint", "passive", "active", "tool-assisted"]},
        "rule_id": {"type": "string", "minLength": 1},
        "rule_origin": {"enum": ["vendor", "project-custom"]},
        "maturity": {"enum": ["release", "beta", "alpha", "candidate"]},
        "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "ERROR"]},
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owasp_top10", "cwe_ids", "wasc_ids"],
          "properties": {
            "owasp_top10": {"const": "2025"},
            "cwe_ids": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}, "uniqueItems": true},
            "wasc_ids": {"type": "array", "items": {"type": "string", "pattern": "^WASC-[0-9]+$"}, "uniqueItems": true}
          }
        },
        "detection_intent": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["required", "if-present"]},
        "evidence_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rule_reference": {"type": "string", "pattern": "^https://"}
      }
    }
  }
}
